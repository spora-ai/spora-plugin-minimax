includes:
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    paths:
        - src
        - tests
    level: 5
    excludePaths:
        - vendor
    bootstrapFiles:
        - vendor/autoload.php

    ignoreErrors:
        # TODO(spora-core): Remove once `spora-ai/spora-core` releases the
        # new `bool|array $required` signature on `#[ToolParameter]` (see
        # https://github.com/spora-ai/spora-core/pull/165).
        -
            identifier: argument.type
            path: src/Tools
